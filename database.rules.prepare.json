{
  "rules": {
    "data": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "board": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true)",
        "reads": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "replies": {
          "$replyId": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true)"
          }
        }
      }
    },
    "tasks": {
      ".read": "auth != null",
      "$taskId": {
        ".write": "auth != null && (newData.exists() || data.child('createdBy').child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true)",
        ".validate": "newData.child('createdBy').child('uid').isString() && (!data.exists() || newData.child('createdBy').child('uid').val() === data.child('createdBy').child('uid').val())",
        "status": {
          ".validate": "newData.val() === 'todo' || newData.val() === 'doing' || newData.val() === 'done'"
        }
      }
    },
    "taskMemos": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$memoId": {
          "status": {
            ".validate": "newData.val() === 'todo' || newData.val() === 'doing' || newData.val() === 'done'"
          }
        }
      }
    },
    "robotImg": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "media": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || ((!data.exists() && newData.exists() && newData.child('by').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('by').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['d', 'by', 'ts']) && newData.child('d').isString() && newData.child('d').val().length <= 500000 && (newData.child('d').val().beginsWith('data:image/') || newData.child('d').val().beginsWith('data:video/')) && newData.child('ts').val() === now"
      }
    },
    "feedback": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true || (query.orderByChild === 'uid' && query.equalTo === auth.uid))",
      ".indexOn": [
        "ts",
        "uid"
      ],
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!newData.exists() || (newData.child('text').isString() && newData.child('text').val().length <= 4000 && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().beginsWith('data:image/') && newData.child('img').val().length <= 400000)))",
        "comments": {
          "$cid": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('feedback').child($id).child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['by', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length <= 1000 && (newData.child('by').val() === 'admin' ? root.child('admins').child(auth.uid).val() === true : (newData.child('by').val() === 'user' && root.child('feedback').child($id).child('uid').val() === auth.uid))"
          }
        }
      }
    },
    "feedbackMemo": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "dutyReq": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === $uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['name', 'kind', 'ts']) && newData.child('kind').isString() && newData.child('kind').val().matches(/^(day|range|open)$/) && (!newData.child('note').exists() || (newData.child('note').isString() && newData.child('note').val().length <= 300)) && (root.child('admins').child(auth.uid).val() === true || (newData.child('status').val() === data.child('status').val() && newData.child('reply').val() === data.child('reply').val())))"
        }
      }
    },
    "shiftReqTpl": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true)"
    },
    "backups": {
      ".read": "auth != null",
      "$date": {
        ".write": "auth != null"
      }
    },
    "backup_meta": {
      ".read": "auth != null",
      "$date": {
        ".write": "auth != null"
      }
    },
    "recent_backup": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null"
    },
    "logs": {
      ".read": "auth != null",
      ".indexOn": [
        "ts"
      ],
      "$logId": {
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "errLogs": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true)",
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.exists()) || ((root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true) && !newData.exists()))",
        ".validate": "!newData.exists() || (newData.hasChildren(['ts', 'msg', 'ver']) && newData.child('ts').val() === now && newData.child('msg').isString() && newData.child('msg').val().length <= 400 && (!newData.child('stack').exists() || (newData.child('stack').isString() && newData.child('stack').val().length <= 1200)))"
      }
    },
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "root.child('admins').child(auth.uid).val() === true"
      }
    },
    "devs": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    },
    "users": {
      ".read": "auth != null",
      ".indexOn": [
        "displayName"
      ],
      "$uid": {
        ".write": "auth.uid === $uid || root.child('admins').child(auth.uid).val() === true"
      }
    },
    "userPerms": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true)",
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "root.child('admins').child(auth.uid).val() === true"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": [
          "read"
        ],
        "$notifId": {
          ".write": "auth != null && (!data.exists() || auth.uid === $uid)"
        }
      }
    },
    "fcmTokens": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "access": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('devs').child(auth.uid).val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    },
    "security": {
      "enforced": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    }
  }
}
