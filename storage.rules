rules_version = '2';

// 新しい添付はアップロード者のUID配下に置く。StorageルールからRTDBの
// /access は参照できないため、利用停止時はAuthentication側の無効化も必要。
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/private/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || (request.resource.size < 50 * 1024 * 1024
          && request.resource.contentType.matches('image/.*|video/.*')));
    }
    match /uploads/{uid}/shared/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || (request.resource.size < 50 * 1024 * 1024
          && request.resource.contentType.matches('image/.*|video/.*')));
    }
    // 旧形式の添付は表示を保ち、新規の書き込みは止める。
    match /taskMemo/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /manual/{allPaths=**} { allow read: if request.auth != null; }
    match /memo/{allPaths=**} { allow read: if request.auth != null; }
    match /board/{allPaths=**} { allow read: if request.auth != null; }
    match /task/{allPaths=**} { allow read: if request.auth != null; }
  }
}
