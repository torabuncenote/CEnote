# kurage（自走ループ）の作業メモと計測証拠。手元にだけ残す
.kurage/

# Syncthing の同期除外設定。端末ごとの設定なので共有しない
.stignore

# Claude Code の端末ローカル設定（launch.json は共有するので除外しない）
.claude/settings.local.json

# OS が作る不要ファイル
.DS_Store

# Firebase CLI のローカルキャッシュ（デプロイ時に生成される）
.firebase/
firebase-debug.log

# 本番ルールの控え（適用前のスナップショット）。手元にだけ残す
.firebase-backup/
